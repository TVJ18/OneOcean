<section class="auth-card">
  <h1>{{title}}</h1>
  <p class="auth-sub">Log in to your One Ocean account.</p>

  {{#if hasErrors}}
    <p class="form-error-banner" role="alert">{{error}}</p>
  {{/if}}

  <form id="login-form" method="POST" action="/login" novalidate>
    <div class="form-field">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" value="{{email}}" autocomplete="email" required />
      <p class="field-error" data-error-for="email"></p>
    </div>

    <div class="form-field">
      <label for="password">Password</label>
      <input type="password" id="password" name="password" autocomplete="current-password" required />
      <p class="field-error" data-error-for="password"></p>
    </div>

    <button class="btn-solid btn-full" type="submit">Log In</button>
  </form>

  <p class="auth-switch">New to One Ocean? <a href="/signup">Sign up</a></p>
</section>

<script src="/js/auth-validation.js" defer></script>
