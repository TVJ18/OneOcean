<a class="back-link" href="/community">&larr; All events</a>

<article class="event-detail">
  <div class="event-detail-head">
    <span class="event-chip">{{event.eventType}}</span>
    <h1>{{event.eventName}}</h1>
  </div>

  <dl class="event-detail-grid">
    <div>
      <dt>Date</dt>
      <dd>{{event.eventDate}}</dd>
    </div>
    <div>
      <dt>Time</dt>
      <dd>{{event.startTime}} &ndash; {{event.endTime}}</dd>
    </div>
    <div>
      <dt>Meeting spot</dt>
      <dd>{{event.meetingLocation}}</dd>
    </div>
    <div>
      <dt>Beach</dt>
      <dd><a href="/beaches/{{event.beachId}}">View beach page</a></dd>
    </div>
  </dl>

  {{#if event.additionalDetails}}
    <p class="event-detail-notes">{{event.additionalDetails}}</p>
  {{/if}}

  <div class="event-detail-actions">
    <span class="event-count-big">{{event.attendants.length}} going</span>

    {{#if isHost}}
      <span class="event-host-note">You're hosting this event.</span>
      <button class="btn-outline" type="button" id="edit-event-toggle">Edit Event</button>
      <button class="btn-danger" type="button" id="cancel-event-btn" data-event-id="{{event._id}}">Cancel Event</button>
    {{else}}
      {{#if isAttending}}
        <span class="event-attending-note">You're going to this event.</span>
      {{else}}
        {{#if user}}
          <form method="POST" action="/community/{{event._id}}/attend">
            <button class="btn-solid" type="submit">RSVP &mdash; I'm going</button>
          </form>
        {{else}}
          <a class="btn-outline" href="/login">Log in to RSVP</a>
        {{/if}}
      {{/if}}
    {{/if}}
  </div>
  {{#if isHost}}
    <form id="event-edit-form" class="event-edit-panel" hidden data-event-id="{{event._id}}">
      <h2>Edit event</h2>
      <p class="form-error-banner" id="edit-error" role="alert" hidden></p>

      <div class="form-field">
        <label for="edit-eventName">Event name</label>
        <input type="text" id="edit-eventName" name="eventName" value="{{event.eventName}}" required />
        <p class="field-error" data-error-for="edit-eventName"></p>
      </div>

      <div class="form-row">
        <div class="form-field">
          <label for="edit-eventType">Event type</label>
          <select id="edit-eventType" name="eventType" data-selected="{{event.eventType}}" required>
            <option value="Meet up">Meet up</option>
            <option value="Beach Cleanup">Beach Cleanup</option>
            <option value="Pinic">Picnic</option>
            <option value="Barbeque">Barbeque</option>
            <option value="Contest">Contest</option>
            <option value="Fishing">Fishing</option>
            <option value="Swimming">Swimming</option>
            <option value="Volleyball">Volleyball</option>
            <option value="Frisbee">Frisbee</option>
            <option value="Football">Football</option>
            <option value="Other">Other</option>
          </select>
          <p class="field-error" data-error-for="edit-eventType"></p>
        </div>
        <div class="form-field">
          <label for="edit-eventDate">Date</label>
          <input type="date" id="edit-eventDate" name="eventDate" data-current="{{event.eventDate}}" required />
          <p class="field-error" data-error-for="edit-eventDate"></p>
        </div>
      </div>

      <div class="form-row">
        <div class="form-field">
          <label for="edit-startTime">Starts</label>
          <input type="time" id="edit-startTime" name="startTime" data-current="{{event.startTime}}" required />
          <p class="field-error" data-error-for="edit-startTime"></p>
        </div>
        <div class="form-field">
          <label for="edit-endTime">Ends</label>
          <input type="time" id="edit-endTime" name="endTime" data-current="{{event.endTime}}" required />
          <p class="field-error" data-error-for="edit-endTime"></p>
        </div>
      </div>

      <div class="form-field">
        <label for="edit-meetingLocation">Meeting spot</label>
        <input type="text" id="edit-meetingLocation" name="meetingLocation" value="{{event.meetingLocation}}" required />
        <p class="field-error" data-error-for="edit-meetingLocation"></p>
      </div>

      <div class="form-field">
        <label for="edit-additionalDetails">Additional details</label>
        <textarea id="edit-additionalDetails" name="additionalDetails" rows="3" required>{{event.additionalDetails}}</textarea>
        <p class="field-error" data-error-for="edit-additionalDetails"></p>
      </div>

      <div class="edit-panel-actions">
        <button class="btn-solid" type="submit">Save Changes</button>
        <button class="btn-outline" type="button" id="edit-event-close">Discard</button>
      </div>
    </form>
  {{/if}}
</article>

<section class="event-comments">
  <h2>Comments ({{event.EventComments.length}})</h2>

  {{#if event.EventComments.length}}
    <ul class="comment-list">
      {{#each event.EventComments}}
        <li class="comment">
          <p class="comment-head">
            <span class="comment-author">{{this.name}}</span>
            <span class="comment-time">{{this.postTime}}</span>
          </p>
          <p class="comment-body">{{this.comment}}</p>
        </li>
      {{/each}}
    </ul>
  {{else}}
    <p class="page-sub">No comments yet. Ask the host a question.</p>
  {{/if}}

  {{#if user}}
    <form class="comment-form" method="POST" action="/community/{{event._id}}/comments">
      <label for="comment">Add a comment</label>
      <textarea id="comment" name="comment" rows="3" maxlength="500" required></textarea>
      <button class="btn-solid" type="submit">Post Comment</button>
    </form>
  {{else}}
    <p class="page-sub"><a href="/login">Log in</a> to join the conversation.</p>
  {{/if}}
</section>

<script src="/js/event-form.js" defer></script>
